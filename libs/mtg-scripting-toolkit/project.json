{
  "name": "mtg-scripting-toolkit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mtg-scripting-toolkit/src",
  "projectType": "library",
  "tags": ["type:util", "domain:mtg", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/mtg-scripting-toolkit",
        "main": "libs/mtg-scripting-toolkit/src/index.ts",
        "tsConfig": "libs/mtg-scripting-toolkit/tsconfig.lib.json",
        "assets": [
          "libs/mtg-scripting-toolkit/*.md"
        ],
        "format": ["cjs", "esm"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/mtg-scripting-toolkit/jest.config.ts"
      }
    },
    "types:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "libs/mtg-scripting-toolkit"
      }
    }
  }
}