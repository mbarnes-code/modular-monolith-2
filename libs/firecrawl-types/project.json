{
  "name": "firecrawl-types",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/firecrawl-types/src",
  "projectType": "library",
  "tags": ["type:library", "domain:firecrawl", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/firecrawl-types",
        "main": "libs/firecrawl-types/src/index.ts",
        "tsConfig": "libs/firecrawl-types/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/firecrawl-types/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/firecrawl-types/jest.config.ts"
      }
    }
  }
}