{
  "name": "@modular-monolith/code-intelligence",
  "version": "1.0.0",
  "description": "Generalized TypeScript AST manipulation and code intelligence tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ast-utils": {
      "types": "./dist/ast-utils.d.ts",
      "import": "./dist/ast-utils.js"
    },
    "./domain-operations": {
      "types": "./dist/domain-operations.d.ts", 
      "import": "./dist/domain-operations.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "babel:build": "babel . --out-dir dist --extensions .ts,.tsx --ignore node_modules,dist",
    "babel:watch": "babel . --watch --out-dir dist --extensions .ts,.tsx --ignore node_modules,dist",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --quiet",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "keywords": [
    "typescript",
    "ast",
    "ts-morph",
    "code-generation",
    "refactoring",
    "ai-enhanced",
    "executive-function",
    "accessibility",
    "security-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbarnes-code/modular-monolith-2.git",
    "directory": "libs/intelligence/code"
  },
  "bugs": {
    "url": "https://github.com/mbarnes-code/modular-monolith-2/issues"
  },
  "homepage": "https://github.com/mbarnes-code/modular-monolith-2#readme",
  "author": "Mental Prosthetic Platform Team",
  "license": "MIT",
  "dependencies": {
    "ts-morph": "^26.0.0",
    "change-case": "^5.4.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "babel-loader": "^9.1.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "memfs": "^4.0.0"
  },
  "peerDependencies": {
    "typescript": ">= 4.9.0"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}