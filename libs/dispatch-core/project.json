    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff format src/",
        "cwd": "libs/dispatch-core"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m pytest tests/ -v",
        "cwd": "libs/dispatch-core"
      }
    }
  },
  "tags": ["type:library", "domain:dispatch", "scope:shared"]
}