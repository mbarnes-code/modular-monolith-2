{
  "name": "dispatch-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/dispatch-core/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff check src/",
        "cwd": "libs/dispatch-core"
      }
