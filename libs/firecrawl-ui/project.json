{
  "name": "firecrawl-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/firecrawl-ui/src",
  "projectType": "library",
  "tags": ["type:ui", "domain:firecrawl", "framework:react"],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/firecrawl-ui",
        "main": "libs/firecrawl-ui/src/index.ts",
        "tsConfig": "libs/firecrawl-ui/tsconfig.lib.json",
        "project": "libs/firecrawl-ui/package.json",
        "entryFile": "libs/firecrawl-ui/src/index.ts",
        "external": ["react/jsx-runtime"],
        "rollupConfig": "@nx/react/plugins/bundle-rollup",
        "assets": [
          {
            "glob": "libs/firecrawl-ui/README.md",
            "input": ".",
            "output": "."
          }
        ]
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/firecrawl-ui/.storybook"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputDir": "dist/storybook/firecrawl-ui",
        "configDir": "libs/firecrawl-ui/.storybook"
      }
    },
    "lint": {
      "executor": "@nx/eslint:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/firecrawl-ui/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/firecrawl-ui/jest.config.ts"
      }
    }
  }
}