{
  "name": "nemesis-file-enrichment-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/nemesis-file-enrichment/file_enrichment_modules",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/**/*.pyc",
        "!{projectRoot}/**/__pycache__"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "poetry build",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/**/*.py",
        "!{projectRoot}/dist/**/*"
      ],
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "poetry run pytest --cov=file_enrichment_modules --cov-report=xml --cov-report=html",
        "cwd": "{projectRoot}"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "poetry run pytest-watch",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.py"],
      "options": {
        "command": "poetry run ruff check .",
        "cwd": "{projectRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.py"],
      "outputs": ["{projectRoot}/**/*.py"],
      "options": {
        "commands": [
          "poetry run ruff check --fix .",
          "poetry run ruff format ."
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/**/*.py"],
      "options": {
        "command": "poetry run mypy file_enrichment_modules",
        "cwd": "{projectRoot}"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/pyproject.toml"],
      "outputs": ["{projectRoot}/poetry.lock"],
      "options": {
        "command": "poetry install",
        "cwd": "{projectRoot}"
      }
    },
    "yara:compile": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/yara_rules/**/*.yar"],
      "outputs": ["{projectRoot}/yara_rules/compiled"],
      "options": {
        "command": "python -c \"import yara; yara.compile(filepaths={'rules': 'yara_rules/'}); print('YARA rules compiled successfully')\"",
        "cwd": "{projectRoot}"
      }
    },
    "yara:validate": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/yara_rules/**/*.yar"],
      "options": {
        "command": "python -c \"import yara; [yara.compile(filepath=f) for f in __import__('glob').glob('yara_rules/**/*.yar', recursive=True)]; print('All YARA rules are valid')\"",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [
    "type:lib",
    "scope:nemesis",
    "framework:python",
    "tier:shared",
    "domain:security",
    "feature:file-analysis"
  ],
  "implicitDependencies": ["nemesis-common"]
}