{
  "name": "onex-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/onex-core/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/onex-core",
        "main": "libs/onex-core/src/index.ts",
        "tsConfig": "libs/onex-core/tsconfig.lib.json",
        "assets": ["libs/onex-core/*.md", "libs/onex-core/src/lib/assets"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/onex-core/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/onex-core/**/*.ts"]
      }
    }
  },
  "tags": ["scope:onex", "type:lib"]
}