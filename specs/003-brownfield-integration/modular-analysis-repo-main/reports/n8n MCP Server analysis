### 4.2 Business Rules and Validation

#### Workflow Creation Business Rules
```typescript
async execute(args: Record<string, any>): Promise<ToolCallResult> {
  const { name, nodes, connections, active, tags } = args;
  
  // Business Rule 1: Name is mandatory for all workflows
  if (!name) {
    throw new N8nApiError('Missing required parameter: name');
  }
  
  // Business Rule 2: Nodes must be properly structured arrays
  if (nodes && !Array.isArray(nodes)) {
    throw new N8nApiError('Parameter "nodes" must be an array');
  }
  
  // Business Rule 3: Connections must be valid object mappings
  if (connections && typeof connections !== 'object') {
    throw new N8nApiError('Parameter "connections" must be an object');
  }
  
  // Business Rule 4: Workflows are inactive by default for safety
  const workflowData = {
    name,
    active: active === true, // Explicit safety check
    nodes: nodes || [],
    connections: connections || {},
  };
}
```

#### Execution Authorization Business Rules
```typescript
class RunWebhookHandler extends BaseExecutionToolHandler {
  async execute(args: Record<string, any>): Promise<ToolCallResult> {
    // Business Rule 1: Webhook credentials required for security
    if (!config.n8nWebhookUsername || !config.n8nWebhookPassword) {
      throw new N8nApiError(
        'Webhook username and password are required for run_webhook tool.',
        400
      );
    }
    
    // Business Rule 2: Workflow name must be valid identifier
    const params = runWebhookSchema.parse(args);
    
    // Business Rule 3: Authentication is mandatory for all webhook calls
    const requestConfig = {
      auth: {
        username: config.n8nWebhookUsername,
        password: config.n8nWebhookPassword
      }
    };
  }
}
