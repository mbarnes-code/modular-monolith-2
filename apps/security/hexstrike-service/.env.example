# HexStrike Service Environment Configuration

# Server Configuration
HEXSTRIKE_HOST=0.0.0.0
HEXSTRIKE_PORT=8000
HEXSTRIKE_DEBUG=true
HEXSTRIKE_ENV=development

# Logging Configuration
HEXSTRIKE_LOG_LEVEL=DEBUG
HEXSTRIKE_LOG_FILE=hexstrike.log

# MCP Configuration
HEXSTRIKE_MCP_HOST=localhost
HEXSTRIKE_MCP_PORT=8001

# Tool Configuration
HEXSTRIKE_TOOLS_TIMEOUT=300
HEXSTRIKE_MAX_WORKERS=4

# Security Configuration
HEXSTRIKE_SECRET_KEY=your-secret-key-here-change-in-production
HEXSTRIKE_API_KEY=your-api-key-here