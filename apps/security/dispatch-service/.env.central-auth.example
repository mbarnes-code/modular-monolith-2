# Dispatch Central Auth Integration Environment Configuration

# Core Central Auth Settings
CENTRAL_AUTH_ENABLED=true
CENTRAL_AUTH_SERVICE_URL=http://localhost:3001
CENTRAL_AUTH_CLIENT_ID=dispatch-service
CENTRAL_AUTH_CLIENT_SECRET=your-dispatch-client-secret

# OAuth2/OIDC Configuration
CENTRAL_AUTH_SCOPES=openid profile email
CENTRAL_AUTH_JWT_AUDIENCE=dispatch-service

# Redis Configuration (for sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Dispatch Authentication Configuration
DISPATCH_AUTHENTICATION_PROVIDER_SLUG=dispatch-auth-provider-central
DISPATCH_JWT_AUDIENCE=dispatch-service

# API Keys for service-to-service communication
CENTRAL_AUTH_SERVICE_API_KEY=your-service-api-key

# Session Configuration
CENTRAL_AUTH_SESSION_TIMEOUT=86400

# Fallback Configuration
CENTRAL_AUTH_FALLBACK_ENABLED=true

# Health Check Configuration  
CENTRAL_AUTH_HEALTH_CHECK_INTERVAL=300

# Database Configuration (Dispatch requires PostgreSQL)
DATABASE_URL=postgresql://dispatch:dispatch@localhost:5432/dispatch
DATABASE_HOSTNAME=localhost
DATABASE_NAME=dispatch
DATABASE_USERNAME=dispatch
DATABASE_PASSWORD=dispatch
DATABASE_PORT=5432

# Dispatch Core Configuration
DISPATCH_UI_URL=http://localhost:8080
DISPATCH_ENCRYPTION_KEY=your-encryption-key-here

# Email Configuration (for notifications)
DISPATCH_EMAIL_HOST=smtp.example.com
DISPATCH_EMAIL_PORT=587
DISPATCH_EMAIL_USERNAME=dispatch@example.com
DISPATCH_EMAIL_PASSWORD=email-password

# Plugin Configuration
DISPATCH_PLUGIN_DISCOVERY_ENABLED=true

# Security Configuration
DISPATCH_ESCAPE_HTML=false
DISPATCH_MARKDOWN_IN_INCIDENT_DESC=true

# Development Configuration
DISPATCH_ENV=development
DISPATCH_DEBUG=true