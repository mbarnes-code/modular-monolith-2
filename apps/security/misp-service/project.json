{
  "name": "misp-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/misp-service/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/config/**/*",
        "{projectRoot}/scripts/**/*",
        "!{projectRoot}/src/app/tmp/**/*"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "echo 'MISP build complete - PHP/CakePHP application ready'",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "command": "echo 'MISP production build complete'"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "php -S localhost:8080 -t src/app/webroot",
        "cwd": "{projectRoot}"
      }
    },
    "serve:apache": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "apache2ctl start && tail -f /var/log/apache2/access.log",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/config/**/*"
      ],
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "php src/app/Console/cake test app AllTests",
        "cwd": "{projectRoot}"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/src/app/Model/**/*",
        "{projectRoot}/tests/**/*"
      ],
      "options": {
        "command": "php src/app/Console/cake test app Model/AllTests",
        "cwd": "{projectRoot}"
      }
    },
    "test:controller": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/src/app/Controller/**/*",
        "{projectRoot}/tests/**/*"
      ],
      "options": {
        "command": "php src/app/Console/cake test app Controller/AllTests",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*.php"],
      "options": {
        "command": "find src/ -name '*.php' -exec php -l {} \\;",
        "cwd": "{projectRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*.php"],
      "outputs": ["{projectRoot}/src"],
      "options": {
        "commands": [
          "find src/ -name '*.php' -exec php-cs-fixer fix {} \\; || echo 'PHP CS Fixer not available, skipping'",
          "find src/ -name '*.php' -exec phpcbf {} \\; || echo 'PHPCS not available, skipping'"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*.php"],
      "options": {
        "command": "find src/ -name '*.php' -exec php -l {} \\;",
        "cwd": "{projectRoot}"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/config/requirements.txt",
        "{projectRoot}/config/requirements-dev.txt",
        "{projectRoot}/config/Pipfile"
      ],
      "outputs": [
        "{projectRoot}/vendor",
        "{projectRoot}/node_modules"
      ],
      "options": {
        "commands": [
          "pip install -r config/requirements.txt",
          "if [ -f composer.json ]; then composer install; fi"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "install:dev": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/config/requirements-dev.txt",
        "{projectRoot}/config/Pipfile"
      ],
      "outputs": ["{projectRoot}/vendor"],
      "options": {
        "command": "pip install -r config/requirements-dev.txt",
        "cwd": "{projectRoot}"
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/.gitmodules"],
      "outputs": [
        "{projectRoot}/src/app/Lib/cakephp",
        "{projectRoot}/src/app/tmp",
        "{projectRoot}/scripts"
      ],
      "options": {
        "commands": [
          "git submodule update --init --recursive src/app/Lib/cakephp",
          "chmod +x scripts/build-deb.sh",
          "chmod +x INSTALL/generic",
          "mkdir -p src/app/tmp/logs",
          "mkdir -p src/app/tmp/cache",
          "chmod -R 755 src/app/tmp"
        ],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "console": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "php src/app/Console/cake",
        "cwd": "{projectRoot}"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "php src/app/Console/cake schema update",
        "cwd": "{projectRoot}"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "dependsOn": ["db:migrate"],
      "options": {
        "command": "php src/app/Console/cake schema create",
        "cwd": "{projectRoot}"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "test", "lint"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/debian/**/*"
      ],
      "outputs": ["{projectRoot}/dist/*.deb"],
      "options": {
        "command": "./scripts/build-deb.sh",
        "cwd": "{projectRoot}"
      }
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/config/**/*",
        "{projectRoot}/infrastructure/docker/**/*"
      ],
      "outputs": ["{projectRoot}/.docker-build"],
      "options": {
        "command": "docker build -t misp-service:latest -f infrastructure/docker/Dockerfile . && touch .docker-build",
        "cwd": "{projectRoot}"
      }
    },
    "docker:run": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker:build"],
      "options": {
        "command": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
        "cwd": "{projectRoot}"
      }
    },
    "docker:stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f infrastructure/docker/docker-compose.yml down",
        "cwd": "{projectRoot}"
      }
    },
    "docker:logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f infrastructure/docker/docker-compose.yml logs -f",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [
    "type:app", 
    "scope:security",
    "framework:php",
    "framework:cakephp", 
    "platform:threat-intelligence",
    "tier:application"
  ],
  "implicitDependencies": []
}