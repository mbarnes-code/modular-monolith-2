# Production Environment Configuration

# Java Configuration
JAVA_OPTS=-Xmx4g -XX:+UseG1GC -XX:+UseStringDeduplication -server
MAVEN_OPTS=-Xmx2g

# Forensic Kit Configuration
FORENSIC_KIT_TEMP_DIR=/var/lib/forensic-analysis
FORENSIC_KIT_MAX_MEMORY=4g
FORENSIC_KIT_SSH_TIMEOUT=60
FORENSIC_KIT_MAX_DEPTH=15
FORENSIC_KIT_CACHE_ENABLED=true
FORENSIC_KIT_MAX_CONCURRENT_ANALYSES=3

# Production Database (if needed)
DATABASE_URL=${DATABASE_URL}
DATABASE_USERNAME=${DATABASE_USERNAME}
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_POOL_SIZE=10

# Production Logging
LOG_LEVEL=INFO
LOG_FORMAT=JSON
LOG_FILE=/var/log/forensic-kit/forensic.log

# Production Features
ENABLE_DEBUG_MODE=false
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DETAILED_LOGGING=false
ENABLE_METRICS=true
METRICS_PORT=9090