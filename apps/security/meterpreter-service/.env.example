# Meterpreter Build Configuration
# Framework directory for installation (change to your metasploit-framework path)
FRAMEWORK_DIR=../metasploit-framework/

# Build temporary directory
BUILD_TMP=posix-meterp-build-tmp

# Architecture targets
DEFAULT_ARCH=x86
SUPPORTED_ARCHS=x86,x64

# Build flags
DEBUG_BUILD=false
ENABLE_LOGGING=true

# OpenSSL and libpcap versions (auto-downloaded)
OPENSSL_VERSION=0.9.8za
LIBPCAP_VERSION=1.1.1

# Cross-compilation settings (for different targets)
CROSS_COMPILE=false
TARGET_PLATFORM=linux