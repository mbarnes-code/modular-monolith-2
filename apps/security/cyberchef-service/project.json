{
  "name": "cyberchef-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cyberchef-service/src",
  "projectType": "application",
  "tags": ["scope:security", "type:frontend", "framework:webpack"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/cyberchef-service",
        "command": "npx grunt prod",
        "cwd": "apps/cyberchef-service"
      },
      "configurations": {
        "development": {
          "command": "npx grunt dev",
          "outputPath": "apps/cyberchef-service/build"
        },
        "production": {
          "command": "npx grunt prod"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npx grunt dev",
        "cwd": "apps/cyberchef-service"
      },
      "configurations": {
        "development": {
          "command": "npx grunt dev"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test",
        "cwd": "apps/cyberchef-service"
      }
    },
    "test:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run testui",
        "cwd": "apps/cyberchef-service"
      }
    },
    "test:node": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run testnodeconsumer",
        "cwd": "apps/cyberchef-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputFile}"],
      "options": {
        "command": "npm run lint",
        "cwd": "apps/cyberchef-service"
      }
    },
    "lint:grammar": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run lint:grammar",
        "cwd": "apps/cyberchef-service"
      }
    },
    "repl": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run repl",
        "cwd": "apps/cyberchef-service"
      }
    },
    "newop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run newop",
        "cwd": "apps/cyberchef-service"
      }
    }
  }
}