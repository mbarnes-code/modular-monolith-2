{
  "name": "kasmvnc-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/kasmvnc-service/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/kasmvnc-service",
        "tsConfig": "apps/kasmvnc-service/tsconfig.app.json",
        "packageJson": "apps/kasmvnc-service/package.json",
        "main": "apps/kasmvnc-service/src/main.ts",
        "assets": ["apps/kasmvnc-service/src/assets"]
      }
    },
    "build:native": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/xorg.build"],
      "options": {
        "command": "./infrastructure/builder/build.sh",
        "cwd": "apps/kasmvnc-service"
      }
    },
    "build:docker": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "docker build -t kasmvnc:dev -f infrastructure/builder/dockerfile.ubuntu_jammy.dev .",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["^build"]
    },
    "build:deb": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/*.deb"],
      "options": {
        "command": "./infrastructure/builder/build-deb",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["build:native"]
    },
    "build:rpm": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/*.rpm"],
      "options": {
        "command": "./infrastructure/builder/build-rpm",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["build:native"]
    },
    "build:apk": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/*.apk"],
      "options": {
        "command": "./infrastructure/builder/build-apk",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["build:native"]
    },
    "build:tarball": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/*.tar.gz"],
      "options": {
        "command": "./infrastructure/builder/build-tarball",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["build:native"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node src/main.ts serve",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["build:docker"]
    },
    "serve:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node src/main.ts serve --dev",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["build:docker"]
    },
    "init-submodules": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/src/kasmweb"],
      "options": {
        "commands": [
          "echo 'Initializing KasmVNC submodules...'",
          "git clone --depth 1 https://github.com/kasmtech/noVNC.git src/kasmweb || echo 'kasmweb already exists'",
          "echo 'KasmVNC submodules initialized successfully'"
        ],
        "cwd": "apps/kasmvnc-service",
        "parallel": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/kasmvnc-service"],
      "options": {
        "jestConfig": "apps/kasmvnc-service/jest.config.ts"
      }
    },
    "test:watch": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/kasmvnc-service/jest.config.ts",
        "watch": true
      }
    },
    "test:native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./run-specs",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["build:native"]
    },
    "test:docker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./infrastructure/builder/build-and-test-deb",
        "cwd": "apps/kasmvnc-service"
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node src/main.ts setup",
        "cwd": "apps/kasmvnc-service"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node src/main.ts clean",
        "cwd": "apps/kasmvnc-service"
      }
    },
    "web:install": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/src/kasmweb/node_modules"],
      "options": {
        "command": "cd src/kasmweb && npm install",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["init-submodules"]
    },
    "web:build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/kasmvnc-service/src/kasmweb/dist"],
      "options": {
        "command": "ts-node src/main.ts build --web",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["web:install"]
    },
    "web:serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node src/main.ts serve --web",
        "cwd": "apps/kasmvnc-service"
      },
      "dependsOn": ["web:install"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Linting skipped - TypeScript parser not configured'"
      }
    },
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node src/main.ts status",
        "cwd": "apps/kasmvnc-service"
      }
    }
  },
  "tags": [
    "type:application",
    "domain:infrastructure", 
    "scope:desktop",
    "technology:vnc",
    "technology:docker", 
    "technology:cpp",
    "technology:cmake",
    "technology:web",
    "technology:nodejs"
  ]
}