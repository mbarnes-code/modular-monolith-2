{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["src/main.ts"],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "jest.config.ts", 
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "tests/**/*"
  ]
}