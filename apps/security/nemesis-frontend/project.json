{
  "name": "nemesis-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/nemesis-frontend/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/public/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/vite.config.js"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npm run build",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run dev",
        "cwd": "{projectRoot}"
      }
    },
    "serve:prod": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npm run preview",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/**/*"
      ],
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "npm run test",
        "cwd": "{projectRoot}"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run test:watch",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*"],
      "options": {
        "command": "npm run lint",
        "cwd": "{projectRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*"],
      "outputs": ["{projectRoot}/src/**/*"],
      "options": {
        "command": "npm run lint:fix",
        "cwd": "{projectRoot}"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*"],
      "options": {
        "command": "npm run type-check",
        "cwd": "{projectRoot}"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/node_modules"],
      "options": {
        "command": "npm install",
        "cwd": "{projectRoot}"
      }
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/dist/**/*",
        "{projectRoot}/Dockerfile"
      ],
      "outputs": ["{projectRoot}/.docker-build"],
      "options": {
        "command": "docker build -t nemesis-frontend:latest . && touch .docker-build",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [
    "type:app",
    "scope:nemesis",
    "framework:react",
    "framework:vite",
    "tier:frontend",
    "domain:security"
  ],
  "implicitDependencies": []
}