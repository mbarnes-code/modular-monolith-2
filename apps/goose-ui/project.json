{
  "name": "goose-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/goose-ui/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "framework:electron",
    "language:typescript",
    "domain:productivity",
    "scope:goose"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "!{projectRoot}/node_modules/**/*"
      ],
      "options": {
        "commands": [
          "npm install",
          "npm run build"
        ],
        "cwd": "apps/goose-ui",
        "parallel": false
      },
      "configurations": {
        "production": {
          "commands": [
            "npm ci",
            "npm run build:prod"
          ]
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/goose-ui"
      },
      "configurations": {
        "development": {
          "command": "npm run dev"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/goose-ui"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/test/**/*",
        "{projectRoot}/package.json"
      ],
      "options": {
        "command": "npm test",
        "cwd": "apps/goose-ui"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*.{ts,tsx,js,jsx}",
        "{projectRoot}/package.json"
      ],
      "options": {
        "command": "npm run lint",
        "cwd": "apps/goose-ui"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/out"],
      "options": {
        "command": "npm run package",
        "cwd": "apps/goose-ui"
      },
      "dependsOn": ["build"]
    }
  },
  "implicitDependencies": ["goose-service"]
}