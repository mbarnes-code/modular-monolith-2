# N8N SSO Configuration for Central Auth Service Integration
# Copy this to .env and update the values for your environment

# Central Auth Service Configuration
AUTH_SERVICE_URL=http://localhost:3001
N8N_OIDC_CLIENT_ID=n8n-service
N8N_OIDC_CLIENT_SECRET=your-client-secret-here

# N8N Configuration
N8N_BASE_URL=http://localhost:5678
N8N_SSO_ENABLED=true

# Authentication Method (must be set for SSO)
N8N_USER_MANAGEMENT_AUTHENTICATION_METHOD=oidc

# Database Configuration (required for N8N user management)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=n8n_password

# Redis Configuration (for session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Security Configuration
N8N_JWT_AUTH_HEADER_NAME=authorization
N8N_JWT_AUTH_HEADER_PREFIX=Bearer

# OIDC Specific Configuration (will be auto-configured by our integration)
# N8N_SSO_OIDC_CLIENT_ID (set via N8N_OIDC_CLIENT_ID)
# N8N_SSO_OIDC_CLIENT_SECRET (set via N8N_OIDC_CLIENT_SECRET)
# N8N_SSO_OIDC_DISCOVERY_ENDPOINT (auto-configured)
# N8N_SSO_OIDC_LOGIN_ENABLED (set via N8N_SSO_ENABLED)

# Additional N8N Configuration
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# Log Level
N8N_LOG_LEVEL=info