{
  "name": "meterpreter-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/meterpreter-service/src",
  "projectType": "application",
  "tags": ["scope:security", "type:native", "framework:make", "language:c", "domain:payload"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/.gitmodules",
        "{projectRoot}/.env.example",
        "{projectRoot}/scripts/setup.sh"
      ],
      "outputs": [
        "{projectRoot}/.env",
        "{projectRoot}/output",
        "{projectRoot}/ReflectiveDLLInjection"
      ],
      "options": {
        "command": "scripts/setup.sh",
        "cwd": "apps/meterpreter-service"
      }
    },
    "deps": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["setup"],
      "inputs": [
        "{projectRoot}/deps",
        "{projectRoot}/Makefile"
      ],
      "outputs": [
        "{projectRoot}/posix-meterp-build-tmp"
      ],
      "options": {
        "command": "make deps || true",
        "cwd": "apps/meterpreter-service"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["setup", "^build"],
      "inputs": [
        "default",
        "{projectRoot}/Makefile",
        "{projectRoot}/Makefile.common",
        "{projectRoot}/.env"
      ],
      "outputs": [
        "{options.outputPath}",
        "{projectRoot}/output",
        "{projectRoot}/data"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/meterpreter-service",
        "command": "make",
        "cwd": "apps/meterpreter-service"
      },
      "configurations": {
        "development": {
          "command": "make debug",
          "outputPath": "apps/meterpreter-service/output"
        },
        "production": {
          "command": "make",
          "outputPath": "dist/apps/meterpreter-service"
        },
        "x86": {
          "command": "make x86",
          "outputPath": "apps/meterpreter-service/output/x86"
        },
        "x64": {
          "command": "make x64",
          "outputPath": "apps/meterpreter-service/output/x64"
        }
      }
    },
    "build:all": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["setup"],
      "inputs": [
        "default",
        "{projectRoot}/Makefile"
      ],
      "outputs": [
        "{projectRoot}/output/x86",
        "{projectRoot}/output/x64"
      ],
      "options": {
        "commands": [
          "make x86",
          "make x64"
        ],
        "parallel": false,
        "cwd": "apps/meterpreter-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/tests/**/*",
        "{projectRoot}/output/**/*"
      ],
      "outputs": [
        "{projectRoot}/test-results"
      ],
      "options": {
        "command": "echo 'Running payload validation tests...' && ls -la output/ 2>/dev/null || echo 'No build outputs found. Run build first.'",
        "cwd": "apps/meterpreter-service"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "scripts/integration-test.sh",
        "cwd": "apps/meterpreter-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.{c,h,cpp,hpp}",
        "{projectRoot}/.clang-format"
      ],
      "options": {
        "command": "find src/ -name '*.c' -o -name '*.h' -o -name '*.cpp' -o -name '*.hpp' | xargs -r clang-format --dry-run --Werror || echo 'clang-format not available, skipping lint'",
        "cwd": "apps/meterpreter-service"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/src/**/*.{c,h,cpp,hpp}"
      ],
      "options": {
        "command": "find src/ -name '*.c' -o -name '*.h' -o -name '*.cpp' -o -name '*.hpp' | xargs -r clang-format -i || echo 'clang-format not available, skipping format'",
        "cwd": "apps/meterpreter-service"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "make clean",
        "cwd": "apps/meterpreter-service"
      }
    },
    "clean:deps": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "make depclean",
        "cwd": "apps/meterpreter-service"
      }
    },
    "clean:all": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "make really-clean",
          "rm -rf dist/apps/meterpreter-service"
        ],
        "parallel": false,
        "cwd": "apps/meterpreter-service"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "make install",
        "cwd": "apps/meterpreter-service"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo '🚀 Meterpreter is a payload generator, not a service.' && echo '📚 Available commands:' && echo '  - nx build meterpreter-service' && echo '  - nx test meterpreter-service' && echo '  - nx install meterpreter-service'",
        "cwd": "apps/meterpreter-service"
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/doxygen.cnf",
        "{projectRoot}/src/**/*"
      ],
      "outputs": [
        "{projectRoot}/docs/generated"
      ],
      "options": {
        "command": "doxygen doxygen.cnf || echo 'Doxygen not available, skipping documentation generation'",
        "cwd": "apps/meterpreter-service"
      }
    },
    "analyze": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/output/**/*"
      ],
      "outputs": [
        "{projectRoot}/analysis"
      ],
      "options": {
        "command": "echo 'Running static analysis on built payloads...' && file output/* 2>/dev/null || echo 'No outputs to analyze'",
        "cwd": "apps/meterpreter-service"
      }
    }
  }
}