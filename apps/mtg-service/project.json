{
  "name": "mtg-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mtg-service/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvicorn src.main:app --reload --host 0.0.0.0 --port 8013",
        "cwd": "apps/mtg-service"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Building MTG service...'",
        "cwd": "apps/mtg-service"
      }
    },
    "test": {
      "executor": "nx:run-commands", 
      "options": {
        "command": "python -m pytest tests/ -v",
        "cwd": "apps/mtg-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff check src/",
        "cwd": "apps/mtg-service"
      }
    }
  },
  "tags": ["type:service", "domain:mtg", "scope:backend"]
}