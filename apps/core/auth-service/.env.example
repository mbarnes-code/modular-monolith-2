# Environment variables for Auth Service

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/auth_service
DB_MAX_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=mm-auth

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ISSUER=modular-monolith-auth
JWT_AUDIENCE=modular-monolith
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# API Key Configuration
API_KEY_PREFIX=mm
API_KEY_SALT=your-api-key-salt-change-in-production

# Security Configuration
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# Session Configuration
SESSION_COOKIE_NAME=mm-session
COOKIE_SAMESITE=lax

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Email Configuration
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@modular-monolith.com