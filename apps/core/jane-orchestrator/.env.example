# Jane Orchestrator Environment Variables

# Environment
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LLM Server URLs
CYBER_LLM_URL=http://localhost:8001
MTG_LLM_URL=http://localhost:8002
CODE_LLM_URL=http://localhost:8003

# Logging
LOG_LEVEL=INFO

# Database (if applicable)
DATABASE_URL=postgresql://user:password@localhost:5432/jane_db

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
API_KEY_HEADER=X-API-Key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
