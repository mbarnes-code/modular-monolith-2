# Constitutional Performance Monitoring Configuration
# T137 - Continuous performance monitoring with threshold alerting

# Enable/disable monitoring
MONITORING_ENABLED=true

# Check interval in seconds
CHECK_INTERVAL=30

# Domain performance thresholds (milliseconds)
SECURITY_THRESHOLD=1000
PRODUCTIVITY_THRESHOLD=2000
MTG_THRESHOLD=3000
INFRASTRUCTURE_THRESHOLD=5000

# UI response threshold for executive function support
UI_THRESHOLD=200

# Alert configuration
MAX_ALERTS_PER_DOMAIN=5
ALERT_COOLDOWN_SECONDS=300

# Monitoring endpoints
SECURITY_ENDPOINT=/api/security/health
PRODUCTIVITY_ENDPOINT=/api/productivity/health
MTG_ENDPOINT=/api/mtg/health
INFRASTRUCTURE_ENDPOINT=/api/infrastructure/health

# Notification settings (for future implementation)
ENABLE_EMAIL_ALERTS=false
ENABLE_SLACK_ALERTS=false
ENABLE_WEBHOOK_ALERTS=false

# Data retention
KEEP_MONITORING_DATA_DAYS=7
MAX_SNAPSHOT_FILES=100