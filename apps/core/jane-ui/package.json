{
  "name": "jane-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.6",
    "@playwright/test": "^1.56.1",
    "@types/node": "22.13.6",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.2",
    "lighthouse": "^12.8.2",
    "prettier": "^3.2.5",
    "typescript": "5.8.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "analyze-bundle": "ANALYZE=true next build",
    "bundle-size-check": "npm run build && node ../../../scripts/measure-bundle-size.js",
    "bundle-size-validate": "npm run build && node ../../../scripts/measure-bundle-size.js --validate",
    "bundle-size-ci": "node ../../../scripts/measure-bundle-size.js --validate --project=.",
    "performance-audit": "lighthouse http://localhost:3000 --output-path=./performance-reports/audit.html --view",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "playwright test --project=performance-chrome tests/performance/",
    "test:performance:all": "playwright test tests/performance/",
    "test:performance:mobile": "playwright test --project=executive-function-mobile",
    "test:regression": "playwright test tests/performance/performance-regression.spec.ts",
    "test:integration": "playwright test tests/integration/",
    "test:monitoring": "playwright test tests/integration/monitoring-integration.spec.ts",
    "performance:baseline": "npm run test:performance && cp performance-reports/results.json performance-reports/baseline-results.json",
    "deploy:production": "node ../../../scripts/deploy-production.js",
    "validate:phase4": "node ../../../scripts/phase4-validation.js",
    "monitor:production": "npm run build && npm start"
  }
}
