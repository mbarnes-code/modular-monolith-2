{
  "name": "jane-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.6",
    "@playwright/test": "^1.56.1",
    "@types/node": "22.13.6",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.2",
    "lighthouse": "^12.8.2",
    "prettier": "^3.2.5",
    "typescript": "5.8.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
