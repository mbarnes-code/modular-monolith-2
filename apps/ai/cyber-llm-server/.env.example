# Cyber LLM Server Environment Variables

# Environment
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8001

# Model Configuration
MODEL_NAME=cyber-model
MODEL_PATH=/models/cyber
MODEL_CACHE_DIR=/cache

# Hardware
GPU_ENABLED=false
GPU_DEVICE=0

# Logging
LOG_LEVEL=INFO

# Performance
MAX_CONCURRENT_REQUESTS=10
TIMEOUT_SECONDS=60
