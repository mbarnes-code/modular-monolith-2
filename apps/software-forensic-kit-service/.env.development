# Development Environment Configuration

# Java Configuration
JAVA_OPTS=-Xmx2g -XX:+UseG1GC -Djava.io.tmpdir=/tmp/forensic-dev
MAVEN_OPTS=-Xmx1g

# Forensic Kit Configuration  
FORENSIC_KIT_TEMP_DIR=/tmp/forensic-analysis-dev
FORENSIC_KIT_MAX_MEMORY=2g
FORENSIC_KIT_SSH_TIMEOUT=30
FORENSIC_KIT_MAX_DEPTH=8
FORENSIC_KIT_CACHE_ENABLED=true

# Development Database (if needed)
DATABASE_URL=jdbc:h2:mem:testdb
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Development Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=TEXT
LOG_FILE=/tmp/forensic-dev.log

# Development Features
ENABLE_DEBUG_MODE=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DETAILED_LOGGING=true