{
  // Editor Settings
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "editor.rulers": [80, 120],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Python Settings
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
  "python.languageServer": "Pylance",
  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,
  "python.linting.pylintEnabled": false,
  "python.formatting.provider": "black",
  "python.formatting.blackArgs": ["--line-length=88"],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.extraPaths": ["./libs/shared"],
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4,
    "editor.rulers": [88],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // TypeScript/JavaScript Settings
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifierEnding": "minimal",
  "typescript.suggest.autoImports": true,
  "typescript.suggest.paths": true,
  "typescript.preferences.includePackageJsonAutoImports": "auto",
  "typescript.workspaceSymbols.scope": "allOpenProjects",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.autoImports": true,
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // JSON/YAML Settings
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  // NX Monorepo Settings
  "nxConsole.showNodeVersionOnStartup": false,
  "nxConsole.enableLibraryImports": true,
  "nxConsole.projectViewingStyle": "list",

  // File Associations
  "files.associations": {
    "*.py": "python",
    "*.ts": "typescript",
    "*.js": "javascript",
    "*.tsx": "typescriptreact",
    "*.jsx": "javascriptreact",
    "*.md": "markdown",
    "Dockerfile*": "dockerfile",
    "docker-compose*.yml": "dockercompose",
    "*.env": "dotenv",
    "*.env.*": "dotenv",
    ".eslintrc*": "json",
    ".prettierrc*": "json",
    "nx.json": "json",
    "project.json": "json",
    "tsconfig*.json": "jsonc"
  },

  // Search/Files Settings
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/dist": true,
    "**/.nx": true,
    "**/tmp": true,
    "**/.next": true,
    "**/coverage": true,
    "**/build": true,
    "**/.pytest_cache": true,
    "**/models/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.nx/cache": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/dist": true,
    "**/tmp": true,
    "**/.next": true,
    "**/coverage": true
  },

  // Git Settings
  "git.ignoreLimitWarning": true,
  "git.autofetch": true,
  "git.enableSmartCommit": true,

  // Docker Settings
  "docker.dockerPath": "docker",
  "docker.enableDockerComposeLanguageService": true,

  // FastAPI/Python API Settings
  "rest-client.environmentVariables": {
    "$shared": {
      "orchestratorUrl": "http://localhost:8000",
      "cyberLlmUrl": "http://localhost:8001",
      "mtgLlmUrl": "http://localhost:8002",
      "codeLlmUrl": "http://localhost:8003",
      "uiUrl": "http://localhost:3000"
    }
  },

  // Performance Settings
  "files.watcherExclude": {
    "**/.nx/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/dist/**": true,
    "**/tmp/**": true,
    "**/.next/**": true,
    "**/models/**": true
  },

  // Terminal Settings
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.cwd": "${workspaceFolder}",

  // Debugging Settings
  "debug.allowBreakpointsEverywhere": true,
  "debug.inlineValues": "on",

  // Extension-specific Settings
  "prettier.configPath": ".prettierrc",
  "eslint.workingDirectories": ["apps", "libs"],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // Tailwind CSS (for Next.js UI)
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.experimental.classRegex": [
    "tw`([^`]*)",
    ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["classnames\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ]
}
