{
  "version": "2.0.0",
  "tasks": [
    // Development Tasks
    {
      "label": "Serve Jane UI",
      "type": "shell",
      "command": "npx",
      "args": ["nx", "serve", "jane-ui"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "webpack is watching the files",
          "endsPattern": "Local:.*http://localhost:3000"
        }
      }
    },
    {
      "label": "Serve Jane Orchestrator",
      "type": "shell",
      "command": "uvicorn",
      "args": [
        "src.api.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/jane-orchestrator",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/apps/jane-orchestrator"
        }
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "INFO:.*Started server process",
          "endsPattern": "INFO:.*Uvicorn running on"
        }
      }
    },
