{
  "name": "jane-monorepo",
  "version": "1.0.0",
  "description": "NX Monorepo with FastAPI, Next.js 15, React 19, and LLM servers",
  "scripts": {
    "postinstall": "nx daemon --start || true",
    "predev": "nx daemon --start || true",
    "dev": "echo 'Nx Daemon Status:' && nx daemon",
    "daemon:start": "nx daemon --start",
    "daemon:stop": "nx daemon --stop",
    "daemon:status": "nx daemon",
    "test": "nx test",
    "build": "nx build",
    "lint": "nx lint",
    "affected:test": "nx affected:test",
    "affected:build": "nx affected:build",
    "affected:lint": "nx affected:lint",
    "graph": "nx graph",
    "dep-graph": "nx dep-graph",
    "clean": "nx reset",
    "format": "nx format",
    "format:check": "nx format:check",
    "diagrams": "./generate-diagrams.sh",
    "diagrams:png": "find . -name '*.mmd' -exec npx mmdc -i {} -o {}.png \\;",
    "diagrams:svg": "find . -name '*.mmd' -exec npx mmdc -i {} -o {}.svg \\;",
    "diagrams:list": "find . -name '*.mmd' -o -name '*diagram*.png' -o -name '*architecture*.png' | head -20",
    "hoist-libraries": "tsx scripts/hoist-libraries.ts --force",
    "hoist-libraries:dry-run": "tsx scripts/hoist-libraries.ts --dry-run",
    "hoist-libraries:preview": "tsx scripts/hoist-libraries.ts --dry-run",
    "validate-hoisting": "tsx scripts/validate-hoisting.ts",
    "analyze-dependencies": "tsx scripts/analyze-dependencies.ts",
    "analyze-n8n-integration": "tsx scripts/n8n-integration-analysis.ts",
    "setup-n8n-infrastructure": "tsx scripts/n8n-infrastructure-setup.ts"
  },
