{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "package": {
      "cache": true,
      "dependsOn": ["build", "^build"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["build", "^build"],
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.eslintrc.json", "{workspaceRoot}/.eslintignore"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.prettierrc", "{workspaceRoot}/.prettierignore"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "affected:build": {
      "cache": true
    },
    "affected:test": {
      "cache": true
    },
    "affected:lint": {
      "cache": true
    },
    "affected:deploy": {
      "cache": false
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/webpack:webpack": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/next:build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*", 
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/*.{yml,yaml}",
      "{workspaceRoot}/.eslintrc.json",
      "{workspaceRoot}/.prettierrc",
      "{workspaceRoot}/.prettierignore",
      "{workspaceRoot}/jest.preset.js",
      "{workspaceRoot}/jest.config.ts",
      "{workspaceRoot}/babel.config.json"
    ]
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build", 
          "lint", 
          "test", 
          "affected:build", 
          "affected:test", 
          "affected:lint",
          "package",
          "format:check",
          "@nx/esbuild:esbuild",
          "@nx/webpack:webpack",
          "@nx/next:build"
        ],
        "parallel": 3,
        "maxParallel": 5,
        "useDaemonProcess": true,
        "cacheDirectory": ".nx/cache"
      }
    }
  },
  "projects": {
    "jane-ui": "apps/jane-ui",
    "jane-orchestrator": "apps/jane-orchestrator",
    "cyber-llm-server": "apps/cyber-llm-server",
    "mtg-llm-server": "apps/mtg-llm-server",
    "infrastructure-llm-server": "apps/infrastructure-llm-server",
    "n8n-workflow-service": "apps/n8n-workflow-service",
    "n8n-service": "apps/n8n-service",
    "security-service": "apps/security-service",
    "productivity-service": "apps/productivity-service",
    "mtg-service": "apps/mtg-service",
    "infrastructure-service": "apps/infrastructure-service",
    "dispatch-service": "apps/dispatch-service",
    "mealie-service": "apps/mealie-service",
    "hexstrike-service": "apps/hexstrike-service",
    "cyberchef-service": "apps/cyberchef-service",
    "commander-spellbook-site": "apps/commander-spellbook-site",
    "commander-spellbook-backend": "apps/commander-spellbook-backend",
    "firecrawl-service": "apps/firecrawl-service",
    "ghostwriter-service": "apps/ghostwriter-service",
    "helk-service": "apps/helk-service",
    "maltrail-service": "apps/maltrail-service",
    "meterpreter-service": "apps/meterpreter-service",
    "dispatch-core": "libs/dispatch-core",
    "dispatch-database": "libs/dispatch-database",
    "firecrawl-ui": "libs/firecrawl-ui",
    "firecrawl-core": "libs/firecrawl-core",
    "firecrawl-types": "libs/firecrawl-types",
    "misp-service": "apps/misp-service",
    "yara-x-service": "apps/yara-x-service",
    "nemesis-service": "apps/nemesis-service",
    "nemesis-web-api": "apps/nemesis-web-api",
    "nemesis-file-enrichment": "apps/nemesis-file-enrichment",
    "nemesis-frontend": "apps/nemesis-frontend",
    "nemesis-document-conversion": "apps/nemesis-document-conversion",
    "nemesis-common": "libs/nemesis-common",
    "nemesis-file-enrichment-lib": "libs/nemesis-file-enrichment",
    "software-forensic-kit-service": "apps/software-forensic-kit-service",
    "forensic-core": "libs/forensic-core",
    "mtg-commander-map-service": "apps/mtg-commander-map-service",
    "mtg-scripting-toolkit": "apps/mtg-scripting-toolkit",
    "apiscout-service": "apps/apiscout-service"
  },
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "next:start",
        "buildTargetName": "next:build",
        "devTargetName": "next:dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "webpack:build",
        "serveTargetName": "webpack:serve",
        "previewTargetName": "preview",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static"
      }
    }
  ],
  "cli": {
    "cache": {
      "enabled": true,
      "environment": "all"
    },
    "analytics": false
  },
  "release": {
    "projects": ["*"]
  },
  "defaultBase": "main"
}
