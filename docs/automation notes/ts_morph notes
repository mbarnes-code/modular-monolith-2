				functions: file.getFunctions().map(f => this.extractFunctionSignature(f)),
				classes: file.getClasses().map(c => this.extractClassStructure(c)),
				imports: file.getImportDeclarations().map(i => this.extractImportPattern(i)),
				exports: file.getExportDeclarations().map(e => this.extractExportPattern(e))
			}));
			
			// 🤖 AI analyzes patterns for cross-domain similarities
			return await this.aiService.findCrossDomainPatterns({
				domain: domain.name,
				astPatterns,
