				name: `${cardType.name}Rules`,
				properties: cardType.properties.map(prop => ({
					name: prop.name,
					type: prop.type,
					docs: [prop.description]
				}))
			});
		});
		
		// ⚡ Generate interaction resolution methods
		const rulesEngine = rulesFile.addClass({ name: 'MTGRulesEngine' });
		rulePatterns.interactions.forEach(interaction => {
			rulesEngine.addMethod(this.generateInteractionMethod(interaction));
		});
		
		return { 
			engine: rulesFile.getFullText(),
			ruleCoverage: rulePatterns.coverageAnalysis 
		};
	}
}
